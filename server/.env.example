# ============================================================
#  Swaraj-ID — Master Environment Template
#  Copy to .env in each sub-directory (whatsapp/, ivr/)
#  and fill in real values.
# ============================================================

# ---------- MongoDB ----------
MONGODB_URI=mongodb://localhost:27017/swaraj-id

# ---------- Twilio ----------
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_PHONE_NUMBER=+1XXXXXXXXXX
TWILIO_WHATSAPP_NUMBER=whatsapp:+14155238886

# ---------- Groq AI ----------
GROQ_API_KEY=gsk_xxxxxxxxxxxxxxxxxxxxxxxx

# ---------- Blockchain (Ethereum Sepolia) ----------
PRIVATE_KEY=0xYOUR_PRIVATE_KEY
CONTRACT_ADDRESS=0xaf606abd76f9581c02762ba0cb2851215abd328c
SEPOLIA_RPC_URL=https://rpc.sepolia.org

# ---------- ngrok ----------
NGROK_URL=https://your-tunnel.ngrok-free.app

# ---------- Ports ----------
GATEWAY_PORT=3000
WHATSAPP_PORT=3001
IVR_PORT=3003
