# Copy to server/.env and fill in. Never put real keys in this file — it is committed.

# ── Core ──
PORT=3001
MONGO_URI=mongodb://localhost:27017
MONGO_DB_NAME=nerve
# Browser origins allowed to call the API (comma-separated). Any localhost port is always allowed.
CLIENT_URL=http://localhost:5173
# Allow Vercel preview URLs of this project, e.g. nerve-allhome → nerve-allhome-*.vercel.app
VERCEL_PROJECT_SLUG=

# ── Auth ──
# Long random string used to sign login tokens. If unset, a random one is generated per boot
# (everyone is logged out on restart). Generate one with: openssl rand -hex 32
JWT_SECRET=

# ── Safety / demo ──
# true = never send real messages (WhatsApp / email / LinkedIn / CRM). Keep true for the public demo.
SIMULATION_MODE=true
# true = still use Groq to write messages / classify replies while sending is simulated
LLM_IN_SIMULATION=false
# true = research real firms with Tavily / Apollo / Groq (read-only — nothing is ever sent)
LIVE_RESEARCH=false
# true = wipe and re-seed the shared AllHome demo workspace on every boot
DEMO_RESET_ON_BOOT=false
# true = allow signed-in (non-demo) users to switch simulation off from the API
ALLOW_LIVE_TOGGLE=false

# ── LLM (Groq) ──
GROQ_API_KEY=
# Groq model id (default openai/gpt-oss-120b)
GROQ_MODEL=
# Used automatically when the primary model is rate-limited (default openai/gpt-oss-20b)
GROQ_FALLBACK_MODEL=

# ── Research providers (read-only) ──
TAVILY_API_KEY=
APOLLO_API_KEY=

# ── Sending providers (only used when SIMULATION_MODE=false) ──
RESEND_API_KEY=
# Verified sending address, e.g. specifiers@yourdomain.com (required for real email)
RESEND_FROM=
HEYREACH_API_KEY=
AISENSY_API_KEY=
# Exact name of an AiSensy API campaign that uses a Meta-approved template
AISENSY_CAMPAIGN_NAME=
